#!/usr/bin/env bash
# testdata/fake-codex: codex stand-in for CI (spawned via the custom
# AgentArgs arm — AgentArgs[0] is this absolute path; the real binary is never
# invoked). Mirrors testdata/fake-opencode's argv diagnostic: records argv so
# tests assert a fresh spawn is exactly [fake-codex, "-p", "kamacu"] (the
# profile layer the session layer prepends, engine-gated) and a resume spawn
# is exactly [fake-codex, "-p", "kamacu", "resume", "<uuid>"]. FAKE_CODEX_ARGS_FILE
# is the recorder (defaults to /dev/null so a stray invocation never fails).
# Preserves the same startup contract as real codex/fake-claude:
# bracketed-paste enable at startup and the SIGTERM -> exit 143 trap.
printf '%s\n' "$@" > "${FAKE_CODEX_ARGS_FILE:-/dev/null}"
printf '\x1b[?2004h'            # bracketed paste on (like the real TUI)
echo "fake codex ready"
if [ -n "${FAKE_CODEX_EXIT_ID:-}" ]; then
  printf 'To continue this session, run \033[32mcodex resume %s\033[0m\n' "$FAKE_CODEX_EXIT_ID"
  exit 0
fi
trap 'exit 143' TERM            # mirrors verified SIGTERM behavior
sleep 300 & wait                # idle until stopped
